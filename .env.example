# Copy this file to `.env`, fill in the value, then restart `npm run dev`.
# `.env` is gitignored so your key never gets committed.

# Contact-form delivery.
# Get a key in about a minute at https://web3forms.com — enter the address you
# want enquiries sent to (zoyasayeedaahmed05@gmail.com) and they email you a key.
# No account or password required.
#
# Without this, the contact form falls back to opening the visitor's own email
# client instead of delivering the message to you directly.
VITE_WEB3FORMS_KEY=
